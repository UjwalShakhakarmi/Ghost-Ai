datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  ownerId        String
  canvasJsonPath String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  collaborators  Collaborator[]
  specs          Spec[]
  taskRuns       TaskRun[]

  @@index([ownerId])
}

model Collaborator {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  role      String   @default("editor")
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model Spec {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  filePath  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model TaskRun {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runId     String   @unique
  taskType  String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}
